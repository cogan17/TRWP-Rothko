// Experimental compile-only target. Not included in PRODUCT_PACKAGES or libvold.
// Build explicitly with: m rothko_weaver_aidl_probe
cc_library_static {
    name: "rothko_weaver_aidl_probe",
    srcs: ["WeaverAidl.cpp"],
    recovery_available: true,
    shared_libs: [
        "android.hardware.weaver-V2-ndk",
        "libbinder_ndk",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

 // Experimental opt-in link probe. Never included in the recovery image.
 // Build only after checking recovery variants and obtaining owner approval.
cc_binary {
    name: "rothko_weaver_aidl_link_probe",
    srcs: ["LinkProbe.cpp"],
    local_include_dirs: ["."],
    recovery_available: true,
    installable: false,
    shared_libs: [
        "android.hardware.weaver-V2-ndk",
        "libbinder_ndk",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
