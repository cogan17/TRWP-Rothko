Compress the vendor ramdisk with zstd instead of lz4.

The lz4 TWRP vendor ramdisk was 64.9 MB in a single platform fragment,
so even normal boot made the MTK bootloader load ~68 MB of ramdisk
(with init_boot), against 44 MB on stock (58 MB in stock recovery). The
3be0761f image bootlooped while every normal-boot file, the header and
the cmdline matched stock and the same layout works on aristotle.
zstd -19 roughly halves the size (measured 0.52x of lz4 on the modules
plus init_boot ramdisk). The device kernel has CONFIG_RD_ZSTD=y (read
from the IKCONFIG in the owner's boot.img).

diff --git a/core/Makefile b/core/Makefile
index 832a155..86e68d4 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -1201,7 +1201,9 @@ endif
 ifeq ($(BOARD_RAMDISK_USE_LZ4),true)
 # -l enables the legacy format used by the Linux kernel
 COMPRESSION_COMMAND_DEPS := $(LZ4)
-COMPRESSION_COMMAND := $(LZ4) -l -12 --favor-decSpeed
+# rothko: zstd halves the vendor ramdisk; the lz4 one (65 MB) overflowed what the
+# MTK bootloader loads and bootlooped. The GKI kernel has CONFIG_RD_ZSTD=y.
+COMPRESSION_COMMAND := /usr/bin/zstd -19 -T0 -q -c
 RAMDISK_EXT := .lz4
 else ifeq ($(BOARD_RAMDISK_USE_XZ),true)
 COMPRESSION_COMMAND_DEPS := $(XZ)
