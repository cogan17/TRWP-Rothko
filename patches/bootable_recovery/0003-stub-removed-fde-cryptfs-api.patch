diff --git a/twrp_fde_compat.h b/twrp_fde_compat.h
new file mode 100644
index 00000000..068a057b
--- /dev/null
+++ b/twrp_fde_compat.h
@@ -0,0 +1,34 @@
+/*
+ * vold 14.1, like AOSP since Android 13, has no FDE, so its cryptfs.h no
+ * longer declares these. TWRP 14.1 still calls them on its FDE fallback
+ * paths; FBE devices never take those paths, so they just fail cleanly.
+ */
+#pragma once
+
+#include <fcntl.h>
+#include <linux/dm-ioctl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+static inline void set_partition_data(const char*, const char*) {}
+static inline int cryptfs_check_footer() { return -1; }
+static inline int cryptfs_get_password_type() { return -1; }
+static inline int cryptfs_check_passwd(const char*) { return -1; }
+
+// Not FDE-only: Format Data uses it to drop the metadata-encryption
+// dm-default-key device ("userdata") before formatting the raw partition.
+static inline int delete_crypto_blk_dev(const char* name) {
+	int fd = open("/dev/device-mapper", O_RDWR | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	struct dm_ioctl io = {};
+	io.version[0] = DM_VERSION_MAJOR;
+	io.version[1] = DM_VERSION_MINOR;
+	io.version[2] = DM_VERSION_PATCHLEVEL;
+	io.data_size = sizeof(io);
+	strlcpy(io.name, name, sizeof(io.name));
+	int ret = ioctl(fd, DM_DEV_REMOVE, &io);
+	close(fd);
+	return ret;
+}
