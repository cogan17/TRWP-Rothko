--- a/libtar/Android.mk
+++ b/libtar/Android.mk
@@ -15,6 +15,10 @@ LOCAL_SHARED_LIBRARIES += libselinux
 
 ifeq ($(TW_INCLUDE_CRYPTO_FBE), true)
     LOCAL_STATIC_LIBRARIES += libvold libscrypt_static
+    # libvold (vold 14.1) also needs these; Make does not pull a Soong static lib's deps
+    LOCAL_STATIC_LIBRARIES += libasync_safe
+    LOCAL_SHARED_LIBRARIES += libsysutils libboot_control_client android.hardware.boot-V1-ndk
+    LOCAL_LDFLAGS += -Wl,--error-limit=0
