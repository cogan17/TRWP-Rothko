+// Devices launched with Android 13+ (e.g. HyperOS) only have the AIDL Gatekeeper HAL
+static std::shared_ptr<aidl::android::hardware::gatekeeper::IGatekeeper> Aidl_Gatekeeper() {
+	const std::string name = std::string(aidl::android::hardware::gatekeeper::IGatekeeper::descriptor) + "/default";
+	ndk::SpAIBinder binder(AServiceManager_checkService(name.c_str()));
+	return binder.get() ? aidl::android::hardware::gatekeeper::IGatekeeper::fromBinder(binder) : nullptr;
+}
+
+// AIDL version of the HIDL verify + addAuthToken in Decrypt_User_Synth_Pass
+static bool Aidl_Gatekeeper_Verify(const userid_t user_id, const password_data_struct& pwd, const unsigned char* password_token) {
+	auto gk = Aidl_Gatekeeper();
+	if (!gk || pwd.handle_len <= 0) {
+		printf("no AIDL gatekeeper or no password handle supplied\n");
+		return false;
+	}
+	void* gk_pwd_token = PersonalizedHashBinary(PERSONALIZATION_USER_GK_AUTH, (const char*)password_token, PASSWORD_TOKEN_SIZE);
+	if (!gk_pwd_token) {
+		printf("malloc error getting gatekeeper_key\n");
+		return false;
+	}
+	std::vector<uint8_t> handle((const uint8_t*)pwd.password_handle, (const uint8_t*)pwd.password_handle + pwd.handle_len);
+	std::vector<uint8_t> key((const uint8_t*)gk_pwd_token, (const uint8_t*)gk_pwd_token + SHA512_DIGEST_LENGTH);
+	free(gk_pwd_token);
+	aidl::android::hardware::gatekeeper::GatekeeperVerifyResponse rsp;
+	auto status = gk->verify(fakeUid(user_id), 0 /* challenge */, handle, key, &rsp);
+	if (!status.isOk() || rsp.statusCode < aidl::android::hardware::gatekeeper::IGatekeeper::STATUS_OK) {
+		printf("AIDL GateKeeper verify failed: %s, code %d, retry after %d ms\n", status.getDescription().c_str(), rsp.statusCode, rsp.timeoutMs);
+		return false;
+	}
+	printf("GateKeeper status ok\n");
+	ndk::SpAIBinder authz_binder(AServiceManager_getService("android.security.authorization"));
+	auto authz = aidl::android::security::authorization::IKeystoreAuthorization::fromBinder(authz_binder);
+	if (!authz || !authz->addAuthToken(rsp.hardwareAuthToken).isOk()) {
+		printf("error: could not add auth token to keystore\n");
+		return false;
+	}
+	return true;
+}
